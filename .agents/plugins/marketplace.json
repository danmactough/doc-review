{
  "name": "doc-review",
  "interface": {
    "displayName": "Doc Review"
  },
  "plugins": [
    {
      "name": "doc-review",
      "description": "Native Markdown document review window for AI coding agents. Adds a doc-review skill in Codex CLI and a /doc-review slash command in Claude Code and pi.",
      "version": "0.1.0",
      "license": "MIT",
      "category": "Engineering",
      "homepage": "https://github.com/danmactough/doc-review",
      "keywords": [
        "markdown",
        "review",
        "document-review",
        "glimpse",
        "pi",
        "doc-review"
      ],
      "source": {
        "source": "local",
        "path": "./plugin"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      }
    }
  ]
}
